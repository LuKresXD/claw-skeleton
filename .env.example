# --- Telegram ---
# Bot token from @BotFather
BOT_TOKEN=123456789:your-bot-token-here
# Your topic-enabled supergroup chat id (usually a negative number)
CHAT_ID=
# Your Telegram user id — the ONLY human allowed to drive the bot
OWNER_USER_ID=

# --- Optional: a second, fully-isolated user ---
# Their sessions run in their own workspace and can't see the owner's data.
# Leave unset to run single-user.
# GUEST_USER_ID=
# GUEST_CHAT_ID=

# --- Optional ---
# Override the workspace root (defaults to ~/claw)
# CLAW_WORKSPACE=
# Path to the Claude Code CLI (defaults to `claude` on PATH)
# CLAUDE_BIN=

# --- Optional: CLI toolbelt ---
# claw-host uploads local files for inline embeds; point it at your bucket.
# Prefer a gitignored secrets/host.env over inlining keys here.
# HOST_PROVIDER=cloudinary        # or s3 / r2
# HOST_CREDENTIALS_FILE=secrets/host.env
