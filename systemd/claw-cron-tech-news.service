[Unit]
Description=Claw v2 Cron Runner: tech-news

[Service]
Type=oneshot
User=youruser
ExecStart=/home/youruser/claw/claw-bot/cron-scripts/run-cron.sh 1000001 /home/youruser/claw/claw-bot/cron-prompts/example.txt 300 sonnet
EnvironmentFile=/home/youruser/claw/claw-bot/.env
Environment=TZ=America/Chicago
TimeoutStartSec=3660
